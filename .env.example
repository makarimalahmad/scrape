SERPAPI_KEY=your_serpapi_key_here

# Opsional: Proxy untuk toko yang memblokir IP Datacenter VPS (misal: Bangjeff)
# Format standar URL: http://username:password@host:port
# PROXY_URL=http://user:pass@isp.decodo.com:10001
# PROXY_DOMAINS=bangjeff.com

# Opsional: Fast-track Real Browser untuk domain tertentu (Default: otomatis fallback saat Cloudflare gagal)
# REAL_BROWSER_DOMAINS=ditusi.co.id

# Opsional: Fallback AI universal jika ekstraksi DOM biasa gagal (Mendukung Groq, DeepSeek, OpenAI, dll.)
# AI_API_KEY=your_api_key_here
# AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=llama-3.3-70b-versatile
