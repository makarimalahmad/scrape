SERPAPI_KEY=your_serpapi_key_here

# Opsional: Fallback AI universal jika ekstraksi DOM biasa gagal
# AI_API_KEY=your_api_key_here
# AI_BASE_URL=https://.../v1/chat/completions
# AI_MODEL=model_name

# Opsional: Proxy untuk toko yang memblokir IP Datacenter VPS (misal: Bangjeff)
# Format standar URL: http://username:password@host:port
# PROXY_URL=http://user:pass@isp.decodo.com:10001
# PROXY_DOMAINS=bangjeff.com

# Opsional: Fast-track Real Browser untuk domain tertentu (Default: otomatis fallback saat Cloudflare gagal)
# REAL_BROWSER_DOMAINS=ditusi.co.id

# Opsional: Tuning performa & resource scraper
# SCRAPER_CONCURRENCY=3       # Jumlah browser paralel (Default: 3, di VPS RAM kecil disarankan 2)
# SCRAPER_LIMIT=10            # Jumlah toko kompetitor Google (Default: 10)
# SCRAPER_MAX_ATTEMPTS=3     # Batas percobaan ulang per toko (Default: 3)
# PAGE_TIMEOUT_MS=90000       # Timeout navigasi halaman web (Default: 90000 ms / 90 detik)
# ADDITIONAL_BLACKLIST_DOMAINS=spamdomain.com,bloganeh.id # Blacklist domain tambahan
